PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SITE_NAME="Jonathan's Portfolio"

# SMTP (email notifications for newsletter subscribers)
# Free options: SendGrid (sendgrid.com), Mailgun (mailgun.com), Gmail App Password, Brevo (brevo.com)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_api_key_here
SMTP_FROM=noreply@portfolio.cm
